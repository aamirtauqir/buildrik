{
  "name": "@buildrik/editor",
  "version": "1.0.0",
  "type": "module",
  "description": "Aquibra Editor \u2014 L2 production-wired extraction",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./themes/*": "./src/themes/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "flowbite:classlist": "flowbite-react build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:no-legacy-settings-path": "grep -r 'components/Panels/LeftSidebar/tabs/settings' src/ --include='*.ts' --include='*.tsx' && echo 'FAIL: legacy settings path found' && exit 1 || echo 'PASS: no legacy settings path'",
    "lint:ds": "bash scripts/ds-grep-gates.sh",
    "verify:ds": "node scripts/verify-design-baselines.mjs && bash scripts/ds-grep-gates.sh && node scripts/check-ds-ssot.mjs && node scripts/conformance/check-token-resolution.mjs && node scripts/check-tsc-baseline.mjs && npm run gate:tokens-generated && npm run gate:vibcoder-ratchet && npm run gate:editor-ui-gone && npm run gate:chrome-ui-surface",
    "gate:tokens": "node scripts/conformance/check-token-resolution.mjs",
    "gate:tsc": "node scripts/check-tsc-baseline.mjs",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "lint:ds-hex": "node scripts/find-inline-hex-v2.mjs",
    "gate:buildrick": "node scripts/check-buildrick-baseline.mjs",
    "gate:ds-ssot": "node scripts/check-ds-ssot.mjs",
    "gate:ds-migrations": "node scripts/check-ds-migrations.mjs",
    "gate:ds-alias": "node scripts/check-alias-fixtures.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "phase5:inventory": "node scripts/phase5-shim-inventory.mjs",
    "phase5:inventory:pretty": "node scripts/phase5-shim-inventory.mjs --pretty",
    "phase5:inventory:strict": "node scripts/phase5-shim-inventory.mjs --strict",
    "tokens:generate": "node scripts/tokens/generate.mjs",
    "gate:tokens-generated": "node scripts/check-tokens-generated.mjs",
    "gate:vibcoder-ratchet": "node scripts/check-vibcoder-ratchet.mjs",
    "gate:editor-ui-gone": "node scripts/check-editor-ui-gone.mjs",
    "gate:chrome-ui-surface": "node scripts/check-chrome-ui-surface.mjs"
  },
  "dependencies": {
    "@buildrik/shared": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-portal": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.39.0",
    "@types/dompurify": "^3.0.5",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.1",
    "flowbite-react": "^0.12.17",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "openai": "^6.13.0",
    "react-colorful": "^5.6.1",
    "react-easy-crop": "^5.5.7",
    "react-window": "^1.8.11",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "agentation": "^3.0.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^28.1.0",
    "playwright-core": "1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.18"
  }
}
