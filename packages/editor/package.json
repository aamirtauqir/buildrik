{
  "name": "@buildrik/editor",
  "version": "1.0.0",
  "type": "module",
  "description": "Aquibra Editor — L2 production-wired extraction",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:no-legacy-settings-path": "grep -r 'components/Panels/LeftSidebar/tabs/settings' src/ --include='*.ts' --include='*.tsx' && echo 'FAIL: legacy settings path found' && exit 1 || echo 'PASS: no legacy settings path'",
    "lint:ds": "bash scripts/ds-grep-gates.sh",
    "verify:ds": "node scripts/verify-design-baselines.mjs && bash scripts/ds-grep-gates.sh",
    "lint:ds-hex": "node scripts/find-inline-hex-v2.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "vibcoder:check-port": "bash scripts/check-vibcoder-port.sh",
    "vibcoder:pin": "bun scripts/vibcoder-bundle-pin.mjs",
    "vibcoder:test": "vitest run scripts/__tests__/vibcoder-codemod.test.mjs",
    "vibcoder:vendor": "bash scripts/vibcoder-vendor.sh"
  },
  "dependencies": {
    "@buildrik/shared": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-portal": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/react": "^10.39.0",
    "@types/dompurify": "^3.0.5",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.1",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "openai": "^6.13.0",
    "react-colorful": "^5.6.1",
    "react-easy-crop": "^5.5.7",
    "react-window": "^1.8.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-window": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "agentation": "^3.0.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^28.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.3.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.18"
  }
}
