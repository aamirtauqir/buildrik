
*,*::before,*::after{box-sizing:border-box}
*{margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{line-height:1.5;-webkit-font-smoothing:antialiased;font-family:Inter, sans-serif}
img,picture,video,canvas,svg{display:block;max-width:100%}
input,button,textarea,select{font:inherit}
p,h1,h2,h3,h4,h5,h6{overflow-wrap:break-word}

:root{--buildrick-design-color-brand-500:#1A56DB;--buildrick-design-color-slate-50:#F8FAFC;--buildrick-design-color-slate-700:#334155;--buildrick-design-color-red-500:#EF4444;--buildrick-design-custom-color-primary-dark:#60A5FA;--buildrick-design-color-primary:var(--buildrick-design-color-brand-500);--buildrick-design-custom-color-secondary:#64748B;--buildrick-design-custom-color-secondary-dark:#94A3B8;--buildrick-design-color-secondary:var(--buildrick-design-custom-color-secondary);--buildrick-design-custom-color-accent:#15803D;--buildrick-design-custom-color-accent-dark:#4ADE80;--buildrick-design-color-accent:var(--buildrick-design-custom-color-accent);--buildrick-design-custom-color-background-dark:#0F172A;--buildrick-design-color-background:var(--buildrick-design-color-slate-50);--buildrick-design-custom-color-page-background:transparent;--buildrick-design-color-page-background:var(--buildrick-design-custom-color-page-background);--buildrick-design-custom-color-text-dark:#E2E8F0;--buildrick-design-color-text:var(--buildrick-design-color-slate-700);--buildrick-design-custom-color-muted:#71717A;--buildrick-design-custom-color-muted-dark:#A1A1AA;--buildrick-design-color-muted:var(--buildrick-design-custom-color-muted);--buildrick-design-custom-color-border:#27272A;--buildrick-design-custom-color-border-dark:#3F3F46;--buildrick-design-color-border:var(--buildrick-design-custom-color-border);--buildrick-design-custom-color-success:#15803D;--buildrick-design-custom-color-success-dark:#4ADE80;--buildrick-design-color-success:var(--buildrick-design-custom-color-success);--buildrick-design-custom-color-warning:#8E4B10;--buildrick-design-custom-color-warning-dark:#FACA15;--buildrick-design-color-warning:var(--buildrick-design-custom-color-warning);--buildrick-design-custom-color-error-dark:#F87171;--buildrick-design-color-error:var(--buildrick-design-color-red-500);--buildrick-design-custom-color-on-primary:#FFFFFF;--buildrick-design-custom-color-on-primary-dark:#FFFFFF;--buildrick-design-color-on-primary:var(--buildrick-design-custom-color-on-primary);--buildrick-design-custom-color-surface-raised:#FFFFFF;--buildrick-design-custom-color-surface-raised-dark:#1E293B;--buildrick-design-color-surface-raised:var(--buildrick-design-custom-color-surface-raised);--buildrick-design-custom-color-surface-muted:#F3F4F6;--buildrick-design-custom-color-surface-muted-dark:#1E293B;--buildrick-design-color-surface-muted:var(--buildrick-design-custom-color-surface-muted);--buildrick-design-custom-color-border-subtle:#E5E7EB;--buildrick-design-color-border-subtle:var(--buildrick-design-custom-color-border-subtle);--buildrick-design-custom-color-text-strong:#111827;--buildrick-design-color-text-strong:var(--buildrick-design-custom-color-text-strong);--buildrick-design-custom-color-text-subtle:#6B7280;--buildrick-design-custom-color-text-subtle-dark:#94A3B8;--buildrick-design-color-text-subtle:var(--buildrick-design-custom-color-text-subtle);--buildrick-design-color-action:var(--buildrick-design-color-brand-500);--buildrick-design-color-surface:var(--buildrick-design-color-slate-50);--buildrick-design-color-text-primary:var(--buildrick-design-color-slate-700);--buildrick-design-color-feedback-error:var(--buildrick-design-color-red-500);--buildrick-design-font-heading:Inter;--buildrick-design-font-body:Inter;--buildrick-design-font-mono:Geist Mono;--buildrick-design-font-size-xs:12px;--buildrick-design-font-size-sm:14px;--buildrick-design-font-size-base:16px;--buildrick-design-font-size-lg:18px;--buildrick-design-font-size-xl:20px;--buildrick-design-font-size-2xl:24px;--buildrick-design-font-size-3xl:30px;--buildrick-design-font-size-4xl:36px;--buildrick-design-space-1:4px;--buildrick-design-space-2:8px;--buildrick-design-space-3:12px;--buildrick-design-space-4:16px;--buildrick-design-space-5:20px;--buildrick-design-space-6:24px;--buildrick-design-space-8:32px;--buildrick-design-space-10:40px;--buildrick-design-space-12:48px;--buildrick-design-radius-none:0;--buildrick-design-radius-sm:4px;--bd-radius-sm:var(--buildrick-design-radius-sm);--buildrick-design-radius-md:8px;--bd-radius-md:var(--buildrick-design-radius-md);--buildrick-design-radius-lg:12px;--buildrick-design-radius-xl:16px;--buildrick-design-radius-full:9999px;--buildrick-design-shadow-sm:0 1px 2px rgba(0,0,0,0.05);--buildrick-design-shadow-md:0 4px 6px rgba(0,0,0,0.1);--buildrick-design-shadow-lg:0 10px 15px rgba(0,0,0,0.15);--buildrick-design-shadow-xl:0 20px 25px rgba(0,0,0,0.25);--buildrick-design-layout-max-width:1280px;--buildrick-design-layout-padding-x:24px;--buildrick-design-layout-columns:12;--buildrick-design-layout-gutter:24px;--buildrick-design-section-padding-y:80px;--buildrick-design-content-max-width:720px;--buildrick-design-base-unit:4px;--buildrick-design-breakpoint-mobile:768px;--buildrick-design-icon-style:outline;--buildrick-design-icon-stroke:1.5;--buildrick-design-icon-sm:16px;--buildrick-design-icon-md:20px;--buildrick-design-icon-lg:24px;--buildrick-design-btn-height-sm:32px;--buildrick-design-btn-height-md:40px;--buildrick-design-btn-height-lg:48px;--buildrick-design-btn-padding-x:16px;--buildrick-design-btn-font-weight:600;--buildrick-design-btn-font-size:14px;--buildrick-design-btn-radius:8px;--buildrick-design-cta-radius:9999px;--buildrick-design-input-height:40px;--buildrick-design-input-radius:8px;--buildrick-design-custom-input-border:#27272A;--buildrick-design-input-border:var(--buildrick-design-custom-input-border);--buildrick-design-custom-input-focus:#3B82F6;--buildrick-design-input-focus:var(--buildrick-design-custom-input-focus);--buildrick-design-input-padding-x:12px;--buildrick-design-label-font-size:13px;--buildrick-design-label-weight:500;--buildrick-design-custom-placeholder-color:#71717A;--buildrick-design-placeholder-color:var(--buildrick-design-custom-placeholder-color);--bd-shadow-sm:0 1px 2px rgba(15,23,42,0.04);--bd-shadow-md:0 4px 12px rgba(15,23,42,0.08);--bd-motion-fast:150ms ease-out;--bd-motion-slow:300ms ease-in-out;--bd-border-default:1px solid;--bd-opacity-50:0.5;--bd-opacity-80:0.8;--bd-zindex-dropdown:1000;--bd-zindex-modal:1050;--bd-breakpoint-md:768px;--bd-breakpoint-lg:1024px;--bd-grid-12:12;--bd-sizing-container:1200px;--bd-sizing-prose:65ch;--bd-icon-default:16px;--bd-imagery-placeholder:https://placehold.co/600x400}

body{color:var(--buildrick-design-color-text,#334155)}
.buildrick-root1 {
  padding: 8px;
}

.buildrick-heroTitle {
  color: rgb(10, 20, 30);
  font-size: 48px;
}

.buildrick-noteText {
  line-height: 1.5;
  --hide-mobile: true;
}

@media (max-width:767px){.buildrick-noteText{display:none!important}}

.buildrick-ctaButton {
  background: rgb(26, 86, 219);
}


[data-buildrick-id="heroTitle"]:hover {
  color: rgb(11, 21, 31);
}

[data-buildrick-id="goneEl"] {
  outline: 7px dotted rgb(1, 2, 3);
}

.hero-title {
  color: rgb(200, 0, 0);
  letter-spacing: 1px;
}

.hero-title:hover {
  color: rgb(0, 200, 0);
}

.card.note {
  border: 1px solid rgb(9, 9, 9);
}

.card {
  padding: 24px;
  border: 2px solid rgb(5, 5, 5);
}

h1 {
  font-weight: 600;
  color: rgb(1, 1, 1);
}

p {
  margin: 0 0 4px;
}

@media (max-width: 1023px) {
[data-buildrick-id="heroTitle"] {
  font-size: 36px;
}
[data-buildrick-id="ctaButton"]:focus {
  outline: 2px solid rgb(0, 0, 0);
}
[data-buildrick-id="goneEl"] {
  font-size: 9px;
}
.hero-title {
  font-size: 30px;
  letter-spacing: 2px;
}
}

@media (max-width: 767px) {
[data-buildrick-id="heroTitle"] {
  font-size: 28px;
}
[data-buildrick-id="aboutText"] {
  font-size: 19px;
}
.card {
  padding: 12px;
}
}