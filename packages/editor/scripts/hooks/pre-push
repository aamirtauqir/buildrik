#!/usr/bin/env bash
# Buildrik editor — pre-push WARN-only DS gate hook.
#
# Runs `pnpm run verify:ds` on every `git push` and prints the result.
# BLOCKING since 2026-05-18 (see BLOCK_ON_FAIL below). This header claimed
# WARN-only for two and a half months after that flip, which is the likely
# reason pushes "hang": the hook is running the full gate suite (~2 min), not
# stalling. Bypass with `git push --no-verify`, and say so when you do.
#
# Rationale: CI was last green 2026-04-16 with months of accumulated drift
# (Gate 17 ghost aliases + unverified Gates 18–25). A blocking hook today
# would prevent every push until that backlog is drained. Hook ships in
# observability mode now so:
#   1. Each push surfaces gate state immediately, not 5 min later in CI.
#   2. New regressions are visible at push-time, not buried in 69 historical
#      reds.
#   3. Drift can be drained incrementally without breaking developer flow.
#
# Upgrade path: when the gate runs fully green, flip BLOCK_ON_FAIL=true
# below to make this a blocking hook. Solo-direct-to-main workflow then
# has effective enforcement (the only path that survives `commit --no-verify`
# is intentional bypass).
#
# Install: bash packages/editor/scripts/install-git-hooks.sh
#
# @license BSD-3-Clause

set -u

BLOCK_ON_FAIL=true  # flipped 2026-05-18 — verify:ds runs fully green end-to-end

# Resolve repo root so the hook works regardless of where push is invoked.
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT/packages/editor"

echo ""
echo "──────────────────────────────────────────────"
echo " Buildrik DS gates (pre-push, BLOCKING mode)"
echo "──────────────────────────────────────────────"

# Run editor + dashboard gates, capture combined exit. Dashboard gate added
# 2026-05-24 — DESIGN.md two-accent enforcement for dashboard chrome.
EDITOR_OK=0
DASH_OK=0
FIGMA_OK=0
ORPHAN_OK=0
AGE_OK=0
pnpm run verify:ds > /tmp/buildrik-pre-push-gate.log 2>&1 || EDITOR_OK=$?
(cd "$REPO_ROOT/packages/dashboard" && pnpm run gate:ds) >> /tmp/buildrik-pre-push-gate.log 2>&1 || DASH_OK=$?
# gate:figma was wired into NO chain at all — not this hook, not CI — and sat
# red for five days before anyone looked. A gate nobody runs is a comment.
# Added 2026-08-19; watched to fail first (change --color-primary in
# app/globals.css and it reports FAIL, exit 1).
(cd "$REPO_ROOT/packages/dashboard" && pnpm run gate:figma) >> /tmp/buildrik-pre-push-gate.log 2>&1 || FIGMA_OK=$?

# Every tRPC procedure has a caller, or an entry saying why not. Added
# 2026-08-27 after the dashboard walk found 27 with no caller — two of which
# were features users could not reach (media folders you could not file into,
# and a site archive with no way back). Watched to fail both ways: drop an
# allowlist entry and it reports the undocumented orphan; allowlist something
# that IS wired and it reports the stale entry.
(cd "$REPO_ROOT/packages/dashboard" && pnpm run gate:trpc-orphans) >> /tmp/buildrik-pre-push-gate.log 2>&1 || ORPHAN_OK=$?

# Conformance spec freshness — prepush mode BLOCKS, because this machine has the
# Figma MCP and can actually re-extract. CI runs the same check in --mode=ci,
# where it only warns: failing a build for something the build cannot fix is how
# people learn to route around a gate. The mode is an explicit argument, never
# inferred from the environment.
#
# Honest about its limits: this is a calendar alarm, not drift detection, and a
# hook installed per clone and bypassable with --no-verify is advisory in the
# end. Spec freshness is a human ritual with a reminder attached.
node scripts/conformance/check-spec-age.mjs --mode=prepush >> /tmp/buildrik-pre-push-gate.log 2>&1 || AGE_OK=$?

if [ "$EDITOR_OK" = "0" ] && [ "$DASH_OK" = "0" ] && [ "$FIGMA_OK" = "0" ] && [ "$ORPHAN_OK" = "0" ] && [ "$AGE_OK" = "0" ]; then
  echo " ✓ all gates passing (editor + dashboard)"
  echo "──────────────────────────────────────────────"
  exit 0
fi

# Gate failed. Show what broke and either warn-or-block.
echo " ✗ one or more gates failing (editor=$EDITOR_OK dashboard=$DASH_OK figma=$FIGMA_OK spec-age=$AGE_OK)"
echo ""
tail -20 /tmp/buildrik-pre-push-gate.log | sed 's/^/   /'
echo ""
echo " full log: /tmp/buildrik-pre-push-gate.log"
echo "──────────────────────────────────────────────"

if [ "$BLOCK_ON_FAIL" = "true" ]; then
  echo " BLOCK: push refused. Fix gate failures and retry."
  echo " Bypass: git push --no-verify  (only with intent)"
  exit 1
fi

echo " WARN: push allowed (BLOCK_ON_FAIL=false). Drain the backlog to flip."
echo "──────────────────────────────────────────────"
exit 0
