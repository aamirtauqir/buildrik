# Re-relocated 2026-05-06 to docs/architecture/vibcoder-spec/ as architecture
# reference (vibcoder-fork). Still untracked — design rationale only, not runtime.
# Excluded from git so it can't drift into the runtime tree.
docs/reference/
docs/architecture/vibcoder-spec/
packages/editor/src/project/

