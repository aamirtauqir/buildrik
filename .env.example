
# Cron / Worker secret (shared between Next.js and cron scheduler)
CRON_SECRET="change-me-in-production"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_..."
STRIPE_BUSINESS_YEARLY_PRICE_ID="price_..."

# Cross-subdomain auth
COOKIE_DOMAIN=.buildrik.com
EDITOR_ORIGIN=https://editor.buildrik.com

# Cross-app navigation
NEXT_PUBLIC_EDITOR_URL=https://editor.buildrik.com
VITE_DASHBOARD_URL=https://buildrik.com

# Vercel publish (Phase 1 — required for real publish; if unset, worker simulates)
# Token: vercel.com/account/tokens (use a team token, not personal)
VERCEL_TOKEN=
# Team ID: vercel.com/teams/<team>/settings (omit if using personal token)
VERCEL_TEAM_ID=
# Project name prefix (default: buildrik-site-)
VERCEL_PROJECT_PREFIX=buildrik-site-

# Editor feature flags (Phase 0 — fake-UI gating; flip to true when backend ships)
VITE_FEATURE_PUBLISH=false
VITE_FEATURE_ACCOUNT=false
VITE_FEATURE_INVITE=false
