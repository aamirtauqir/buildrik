# Local dev template: copy to .env.local (repo root) AND put DATABASE_URL in
# packages/dashboard/.env too — the Prisma CLI reads only `.env`. See README.md.

# Database — matches docker-compose.yml; any local Postgres works.
DATABASE_URL="postgresql://buildrik:buildrik@localhost:5432/buildrik"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (SMTP / nodemailer). Nothing in this codebase reads RESEND_API_KEY —
# that key was documented here long after the transport moved to SMTP.
SMTP_HOST=""
SMTP_PORT="465"          # 465 = implicit TLS. Anything else starts plaintext + STARTTLS.
SMTP_USER=""
# Base64 of the password, NOT the password. Next expands `$VAR` inside .env*
# files (quotes do not stop it) and cPanel's shell eats `$` too, so a password
# containing a dollar sign is silently truncated and every send fails with
# `535 Incorrect authentication data`. Base64 has no metacharacters.
#   printf %s 'your-password' | base64
SMTP_PASS_B64=""
EMAIL_FROM="Buildrick <info@buildrick.io>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Without this, the dashboard's "Edit site" points at the dead :5050 standalone
# demo instead of the real editor at /edit/:id (CLAUDE.md §Editor).
NEXT_PUBLIC_UNIFIED_EDITOR=true
