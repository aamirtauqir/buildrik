{
  "name": "@buildrik/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "email:dev": "email dev --dir emails",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:rules": "node scripts/audit/rule-drift-scan.mjs",
    "env:check": "node scripts/check-prod-env.mjs",
    "env:check:local": "node scripts/check-prod-env.mjs --file .env.local --dev",
    "env:check:prod": "bash scripts/check-prod-env-live.sh",
    "env:set:prod": "node scripts/set-prod-env.mjs",
    "stripe:setup": "tsx --tsconfig packages/dashboard/tsconfig.json scripts/stripe-setup.ts",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:reset": "node scripts/dev-clean.mjs && rm -rf packages/dashboard/.next packages/editor/dist packages/editor/node_modules/.vite",
    "smoke:prod": "node scripts/smoke-deployed.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@emotion/react": "^11.14.0",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.60.0",
    "@trpc/client": "^11.14.0",
    "@trpc/next": "^11.14.0",
    "@trpc/react-query": "^11.14.0",
    "@trpc/server": "^11.14.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "flowbite-react": "^0.12.17",
    "isomorphic-dompurify": "^3.16.0",
    "lucide-react": "^0.460.0",
    "next": "^16.2.0",
    "next-auth": "5.0.0-beta.30",
    "openai": "^6.33.0",
    "otplib": "^12.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.2",
    "superjson": "^2.2.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "nodemailer": "^7.0.13",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "react-email": "^5.2.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
