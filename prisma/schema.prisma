// ─── Phase 0.5 — Media + Versions models ──────────────────────────────────

/// Phase 0.5: server-backed media library. Replaces editor's IndexedDB-only
/// model (MediaStorage + IndexedDBAdapter) with persisted asset rows. Storage
/// caps enforced via PLAN_LIMITS[plan].storageMB. Editor IndexedDB stays as
/// offline cache; reconciliation happens on connect.
/// `type` values: "image" | "video" | "icon" | "font" (matches editor TypePills).
/// Stored as String (not enum) to match repo convention; validated at Zod boundary.
model MediaAsset {
  id                String   @id @default(cuid())
  userId            String
  siteId            String?
  folderId          String?
  url               String
  bytes             Int      @default(0)
  type              String
  mimeType          String
  filename          String
  altText           String?
  generatedMetadata Json?
  userMetadata      Json?
  lastJobKey        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions MediaAssetVersion[]
  folder   MediaFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, url], name: "MediaAsset_userId_url_unique")
  @@index([userId, type, createdAt])
  @@index([folderId])
  @@index([siteId])
  @@map("media_assets")
}

/// Phase A: media-asset folders. Tree structure via parentId. Cascade-delete
/// policy is "move assets to root" per resolved decision #6 (handled in
/// media-folder.service.ts deleteFolder transaction, NOT via Prisma cascade).
model MediaFolder {
  id       String  @id @default(cuid())
  userId   String
  siteId   String?
  name     String
  parentId String?

  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaFolder[] @relation("MediaFolderTree")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, parentId])
  @@index([siteId])
  @@map("media_folders")
}

/// Phase B: per-asset edit history. Image editor (crop/rotate/adjust) saves
/// a new version row instead of overwriting the original. Retention capped
/// via PLAN_LIMITS[plan].assetVersionsCap (decision #7: 5/25/100 by tier).
model MediaAssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  url       String
  bytes     Int      @default(0)
  edits     Json
  createdAt DateTime @default(now())

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("media_asset_versions")
}

/// Phase B: template revisions. Lets "newer version available" banner + per-version
/// restore work in the Templates extended drawer. Retention unlimited
/// (decision #7: templates are deliberate artifacts, low churn).
model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String
  semver      String
  pages       Json
  changelogMd String?
  createdAt   DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, semver])
  @@index([templateId, createdAt])
  @@map("template_versions")
}

/// Version history, server-backed (#3/26, 2026-06-24). The editor's
/// VersionTimelineManager still owns the local IndexedDB cache; this mirrors
/// each named/auto version so history is shared per-site and survives a new
/// device / cache clear (REQUIRED before real-time collab, where per-browser
/// histories would diverge). `payload` is the full engine NamedVersion (incl.
/// the project snapshot); list endpoints return metadata columns only so a
/// 50-version list never ships 50 snapshots.
model SiteVersion {
  id        String   @id @default(cuid())
  siteId    String
  versionId String // engine NamedVersion.id — canonical match for dedupe/restore
  name      String
  isAuto    Boolean  @default(false)
  payload   Json
  createdBy String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, versionId])
  @@index([siteId, createdAt])
  @@map("site_versions")
}

/// Reusable component masters, server-backed (#4/27, 2026-06-24). The editor's
/// ComponentManager keeps the local IndexedDB cache (`aquibra-components`); this
/// mirrors each master so a saved component is shared across the agency's client
/// sites + survives device/cache loss (the agency-reuse wedge, and required
/// before collab where per-browser libraries would diverge). `payload` is the
/// full engine ComponentDefinition.
model SiteComponent {
  id          String   @id @default(cuid())
  siteId      String
  componentId String // engine ComponentDefinition.id — canonical dedupe key
  name        String
  payload     Json
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, componentId])
  @@index([siteId, updatedAt])
  @@map("site_components")
}

/// User "My Templates" (save-as-template), server-backed (#13/25, 2026-06-24).
/// The editor's handleSaveTemplate writes the local cache (localStorage
/// MY_TEMPLATES); this mirrors each so saved templates are shared across the
/// agency's sites + survive device/cache loss. Workspace-scoped (an agency's
/// reusable library), resolved from the editing site's workspace.
model UserTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  templateId  String // editor's "user-<ts>" id — canonical dedupe key
  name        String
  category    String?
  description String?
  html        String
  css         String?
  thumbnail   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, templateId])
  @@index([workspaceId, updatedAt])
  @@map("user_templates")
}

