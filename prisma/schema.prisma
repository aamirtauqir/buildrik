/// Idempotency ledger for inbound Stripe webhook events. Stripe retries
/// delivery until it gets a 2xx, so a slow/duplicate delivery used to fire
/// the side effects (PAST_DUE flip + payment-failed notification/email)
/// multiple times. The route inserts the event id here first; a duplicate
/// insert (P2002) means "already handled" → skip.
model ProcessedWebhookEvent {
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_webhook_events")
}

/// Small-asset upload handshake (presign → PUT body → confirm). Previously an
/// in-memory Map: on serverless the presign and the PUT hit different lambdas,
/// so valid uploads 404'd. Rows expire after 10 minutes (enforced on read,
/// pruned by the session-cleanup cron).
model PendingUpload {
  id        String   @id
  fileName  String
  fileType  String
  context   String
  userId    String
  wsId      String
  siteId    String?
  storedUrl String?
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("pending_uploads")
}

/// Shared rate-limit counters (serverless-safe — the previous in-memory Map
/// reset per lambda, multiplying every limit by instance count). One row per
/// key; count and window reset atomically inside a single upsert. Expired
/// rows are pruned by the session-cleanup cron.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// Operation log for DB-backed real-time collaboration (SSE fan-out).
/// Clients POST ops here; an SSE stream replays ops with seq > the client's
/// last-seen seq. Pruned by a cron once applied/old.
model CollabOperation {
  id        String   @id @default(cuid())
  siteId    String
  seq       Int      @default(autoincrement())
  authorId  String
  clientId  String
  op        Json
  createdAt DateTime @default(now())

  @@index([siteId, seq])
  @@index([createdAt])
  @@map("collab_operations")
}
