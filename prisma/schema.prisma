generator client {
  provider      = "prisma-client-js"
  // native = developer's local target (darwin on Mac, linux on dev box).
  // Linux targets cover the cPanel CloudLinux production hosts and
  // common container/serverless platforms. Update if prod stderr emits
  // "could not locate the Query Engine for runtime X" — add X here.
  binaryTargets = ["native", "debian-openssl-1.0.x", "rhel-openssl-1.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  fullName          String
  displayName       String?
  passwordHash      String?
  avatar            String?
  bio               String?
  language          String    @default("en")
  timezone          String    @default("UTC")
  emailVerified     DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  backupCodes       String[]
  provider          String    @default("email")
  lockedUntil       DateTime?
  failedAttempts    Int       @default(0)
  lastLoginAt       DateTime?
  emailBounceCount  Int       @default(0)
  deletedAt         DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  workspaceMembers WorkspaceMember[]
  aiUsage          AIUsage[]
  apiTokens        ApiToken[]
  knownDevices     KnownDevice[]
  lessonProgress   LessonProgress[]

  @@map("users")
}

/// Which Learn lessons a user has finished. The lessons themselves are code
/// constants (packages/shared/schemas/learn.ts COURSES), not rows, so this joins
/// to them by `lessonSlug` — a plain string, deliberately not a foreign key.
/// A lesson removed from the constant leaves an orphan row here that no read
/// surfaces; the alternative (a Lesson table) would mean a migration every time
/// a video is added, which is exactly the overhead the code-constant model avoids.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonSlug  String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([userId])
  @@map("lesson_progress")
}

/// A device/location the user has successfully signed in from before. Stored as
/// a coarse HMAC fingerprint (browser-family+OS + IP /24), never raw IP/UA, so a
/// new-device sign-in can trigger a security alert without keeping reversible PII.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("known_devices")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  device       String?
  ip           String?
  location     String?
  current      Boolean  @default(false)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  type       String
  expires    DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([token, type, used])
  @@index([expires])
  @@map("verification_tokens")
}

model WorkspaceMember {
  id           String    @id @default(cuid())
  userId       String
  workspaceId  String
  role         String    @default("EDITOR")
  status       String    @default("ACTIVE")
  invitedBy    String?
  lastActiveAt DateTime?
  suspendedAt  DateTime?
  joinedAt     DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sitePermissions SitePermission[]

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model Workspace {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  ownerId             String
  plan                String    @default("FREE")
  defaultLanguage     String    @default("en")
  timezone            String    @default("UTC")
  stripeCustomerId    String?   @unique
  deletionScheduledAt DateTime?
  deletedAt           DateTime?
  iconUrl             String?
  accentColor         String?
  // E2-T5b shared theme: a captured snapshot of one site's design tokens that
  // the agency pushes to its client sites. Opaque Json (same shape as
  // Site.projectStyles). Null until first captured.
  sharedTheme         Json?
  sharedThemeUpdatedAt DateTime?
  // m-approval: when on, content editors send edits for review instead of
  // publishing directly; an Admin approves to publish. Default off (solo flow).
  editsRequireApproval Boolean  @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members         WorkspaceMember[]
  sites           Site[]
  invites         Invite[]
  subscription    Subscription?
  integrations    WorkspaceIntegration[]
  sharingSettings WSSharingSettings?
  folders         Folder[]
  activityLogs    ActivityLog[]
  aiAdoptionEvents AiAdoptionEvent[]
  apiTokens       ApiToken[]
  features        WorkspaceFeature[]
  clients         Client[]
  userTemplates   UserTemplate[]
  themeSnapshots  SiteThemeSnapshot[]
  themePresets    WorkspacePreset[]
  referrals       Referral[]
  apps            WorkspaceApp[]

  @@map("workspaces")
}

// Per-workspace marketplace install. Only "Install"-action catalog apps are
// written here (Connect-type apps are third-party OAuth and live in
// WorkspaceIntegration). A row's existence == installed; uninstall deletes it.
// appId matches CatalogApp.id in lib/marketplace-catalog.ts.
model WorkspaceApp {
  id          String   @id @default(cuid())
  workspaceId String
  appId       String
  installedAt DateTime @default(now())
  // Per-app configuration (e.g. Live Chat property/widget id). Shape is
  // validated per appId by packages/shared/schemas/marketplace.ts before write.
  // An installed app only affects published sites once this holds valid config.
  config      Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, appId])
  @@index([workspaceId])
  @@map("workspace_apps")
}

// Partner-program referral. A workspace refers others; each signed-up referral
// carries the plan it converted on plus influenced MRR and earned commission.
// Populated by the referral-tracking flow (not yet wired) — reads real rows.
model Referral {
  id              String   @id @default(cuid())
  workspaceId     String
  referredName    String
  referredEmail   String?
  plan            String
  mrrCents        Int      @default(0)
  commissionCents Int      @default(0)
  signedUpAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("referrals")
}

// D4 (brand presets): an agency's named brand presets — captured token sets they
// can apply as the shared theme and push. Built-in starter presets live in the
// editor (STARTER_DS_REGISTRY); this is the agency's OWN multi-brand library
// (the single Workspace.sharedTheme only holds one).
model WorkspacePreset {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  styles      Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
  @@map("workspace_presets")
}

// Per-workspace feature flags — DB-backed runtime kill-switch (eng-review 2026-06-19).
// Keys: "agency_layer" (E2), "client_mode" (E4). Absent row = disabled (default-off).
model WorkspaceFeature {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("workspace_features")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  action    String
  status    String
  ip        String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Site {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  slug              String    @unique
  status            String    @default("DRAFT")
  template          String?
  templateId        String?
  creationMethod    String    @default("BLANK")
  thumbnail         String?
  pages             Int       @default(0)
  aiJobId           String?
  lastEditedAt      DateTime  @default(now())
  lastPublishedAt   DateTime?
  lastPublishError  String?
  publishedUrl      String?
  createdBy         String
  headCode          String?
  bodyCode          String?
  socialLinks       Json?
  publishedPassword String?
  metaTitle         String?
  metaDescription   String?
  metaTitleTemplate String?
  ogImage           String?
  // Technical SEO (d5): canonical host, search-index opt-out, custom robots.txt.
  canonicalUrl      String?
  allowIndexing     Boolean   @default(true)
  robotsTxt         String?
  touchIcon         String?
  favicon           String?
  folderId          String?
  clientId          String?
  lastPublishedBy   String?
  projectStyles     Json?
  dsSchemaVersion   Int       @default(0)
  // E2-T5b per-site override: when true, the agency shared-theme push skips
  // this site (it keeps its own tokens). Default false = follows the shared theme.
  themeLocked       Boolean   @default(false)
  projectAssets     Json?
  projectSettings   Json?
  cspPolicy         String?
  hstsMaxAge        Int?
  xFrameOptions     String?
  referrerPolicy    String?
  permissionsPolicy String?
  defaultLocale     String    @default("en")
  enabledLocales    String[]  @default(["en"])
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder          Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sourceTemplate  Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sitePages       Page[]
  domains         Domain[]
  shareLinks      ShareLink[]
  permissions     SitePermission[]
  analytics       SiteAnalytics[]
  formBlocks      FormBlock[]
  formSubmissions FormSubmission[]
  redirects       Redirect[]
  slugHistory     SlugHistory[]
  publishJobs     PublishBuildJob[]
  analyticsEvents AnalyticsEvent[]
  reviewRequests  ReviewRequest[]
  comments        Comment[]
  reviewers       Reviewer[]
  cmsCollections  CmsCollection[]
  versions        SiteVersion[]
  components      SiteComponent[]
  themeSnapshots  SiteThemeSnapshot[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([clientId])
  @@map("sites")
}

// D2 (theme rollback): a site's projectStyles snapshot taken right before a
// shared-theme push overwrites it. Lets the agency roll a bad push back. Bounded
// per site by a retention cap in theme.service (oldest pruned on capture).
model SiteThemeSnapshot {
  id                  String   @id @default(cuid())
  siteId              String
  workspaceId         String
  prevStyles          Json?
  prevDsSchemaVersion Int
  createdAt           DateTime @default(now())

  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([workspaceId])
  @@map("site_theme_snapshots")
}

// CMS server persistence (redesign E7). The editor's CMS already works locally
// (IndexedDB via engine CollectionManager); these models move it server-side so
// collections + entries sync across devices/users and survive. `fields` is the
// CMSField[] array (engine src/shared/types/cms.ts), `data` is an entry's
// field-value map — both Json so the editor can round-trip its own shapes.
model CmsCollection {
  id           String   @id @default(cuid())
  siteId       String
  name         String
  slug         String
  description  String?
  icon         String?
  displayField String?
  fields       Json     @default("[]")
  // Dynamic-page binding (redesign E7): when pageSlugPattern is set, this
  // collection generates one published page per entry. Patterns use {fieldSlug}
  // placeholders resolved against each entry's data (pattern SEO).
  pageSlugPattern    String?
  pageSeoTitle       String?
  pageSeoDescription String?
  // The publish-payload path of the page that templates each entry (e.g.
  // "blog/_template/index.html"). The publish step renders it per entry.
  pageTemplatePath   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site    Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entries CmsEntry[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@map("cms_collections")
}

model CmsEntry {
  id           String   @id @default(cuid())
  collectionId String
  data         Json     @default("{}")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection CmsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, status])
  @@map("cms_entries")
}

// Client comment review (redesign E7). A viewer/client pins a change-request on
// the preview (x/y + optional element selector) without canvas access; the
// agency resolves it. Pin coordinates are page-relative fractions (0..1) so they
// survive viewport changes. Deleting a site removes its comments.
model Comment {
  id     String  @id @default(cuid())
  siteId String
  pageId String?
  /// Internal author (a workspace member). Exactly ONE of authorId /
  /// reviewerId is set — enforced by a CHECK constraint on the `comments`
  /// table, because a comment has one author and an orphan has neither.
  authorId       String?
  /// External author — an account-less client reviewing via a token link.
  reviewerId     String?
  body           String
  x              Float?
  y              Float?
  targetSelector String?
  status         String    @default("OPEN") // OPEN | RESOLVED
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reviewer Reviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([reviewerId])
  @@map("comments")
}

// Invited-client review workflow (redesign E4). A content editor "sends for
// review" instead of publishing; an admin approves or asks for changes. One
// PENDING request per site at a time. Deleting a site removes its review history.
//
/// Hand-authored partial UNIQUE index — see
/// migrations/20260721130000_review_pending_unique. Enforces at most one row
/// per `siteId` with status 'PENDING'. Prisma's schema language can't express
/// partial unique indexes, so the constraint lives only in SQL. Do NOT add an
/// `@@unique([siteId])` here — that would create a separate, conflicting full
/// unique index on next migrate.
model ReviewRequest {
  id            String    @id @default(cuid())
  siteId        String
  requestedById String
  status        String    @default("PENDING") // PENDING | APPROVED | CHANGES_REQUESTED
  note          String?
  // m-approval: human-readable summary of what changed in this submission
  // (e.g. "hero copy, 2 images"), shown to the reviewer as a lightweight diff.
  changeSummary String?
  /// The site's rendered HTML **frozen at send** (contracts §1.6): an array of
  /// { path, html } produced by the editor's ExportEngine at submit time — the
  /// same page payload publish deploys. The client review page renders THIS, not
  /// the live draft, so the client always sees the version they were sent.
  /// Re-sending re-renders and overwrites it (a new token, a new snapshot).
  /// Null on internal submits with no editor render.
  snapshotPages Json?
  resolvedById  String?
  resolvedAt    DateTime?
  /// Opaque token the client's /review/<token> link carries. Unique and
  /// indexed because it is the lookup key on every unauthenticated request.
  /// Null on legacy rows created before the client loop existed.
  token         String?   @unique
  /// 90 days from send. Past this the link renders the expired screen —
  /// not a 404, not a login prompt.
  expiresAt     DateTime?
  /// Set when a re-send supersedes this link, or when the designer revokes
  /// it by hand. A revoked token is dead immediately; it is never reissued.
  revokedAt     DateTime?
  /// The address the link was actually sent to. Identity capture must match
  /// it — otherwise the token holder can sign as anyone, and an approval that
  /// can be forged is worth less than no approval at all because it looks
  /// authoritative. Null means no client was invited, and no client may sign.
  invitedEmail  String?   @db.VarChar(320)
  /// Who reviewed. Captured on first visit (name + email, no password) and
  /// carried forward when a later round re-sends to the same person.
  reviewerId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reviewer Reviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([reviewerId])
  @@map("review_requests")
}

/// An account-less client who reviews a site. Deliberately NOT a `User`:
/// the wedge dies if a restaurant owner has to create an account to say yes.
/// Scoped to the site rather than to a token, so that round 2 recognises the
/// same person after a re-send issues a fresh token.
model Reviewer {
  id          String   @id @default(cuid())
  siteId      String
  name        String   @db.VarChar(120)
  email       String   @db.VarChar(320)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reviews  ReviewRequest[]
  comments Comment[]

  @@unique([siteId, email])
  @@index([siteId])
  @@map("reviewers")
}

model Page {
  id              String   @id @default(cuid())
  siteId          String
  name            String   @db.VarChar(100)
  slug            String   @db.VarChar(100)
  position        Int
  blocks          Json     @default("[]")
  isHomePage      Boolean  @default(false)
  seoTitle        String?  @db.VarChar(60)
  seoDescription  String?  @db.VarChar(160)
  meta            Json?
  settings        Json?
  slugHistory     Json?
  slugManuallySet Boolean  @default(false)
  translations    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@map("pages")
}

model Domain {
  id            String    @id @default(cuid())
  siteId        String
  domain        String    @unique
  status        String    @default("PENDING")
  sslStatus     String    @default("PENDING")
  sslExpiresAt  DateTime?
  lastCheckedAt DateTime?
  autoRenewSsl  Boolean   @default(true)
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  site       Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  dnsRecords DnsRecord[]

  @@map("domains")
}

model DnsRecord {
  id       String  @id @default(cuid())
  domainId String
  type     String
  host     String
  value    String
  verified Boolean @default(false)

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("dns_records")
}

// Agency layer (redesign E2). A Client is an agency's customer account that
// groups Sites and carries white-label branding. Distinct from Folder (generic
// site organization): a Client owns branding + drives the m-agency dashboard.
// Sites with clientId = null are "solo" (no agency layer). Deleting a Client
// orphans its sites (Site.clientId SetNull), never deletes them.
model Client {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  logoUrl      String?
  brandColor   String?
  customDomain String?
  hideBuildrik Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sites     Site[]

  @@index([workspaceId])
  @@map("clients")
}

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sites     Site[]

  @@index([workspaceId])
  @@map("folders")
}

model Invite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("EDITOR")
  message     String?
  token       String   @unique
  status      String   @default("PENDING")
  invitedBy   String
  siteIds     String[]
  resendCount Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("invites")
}

model ShareLink {
  id           String    @id @default(cuid())
  siteId       String
  name         String
  token        String    @unique
  passwordHash String?
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isActive])
  @@map("share_links")
}

model SitePermission {
  id            String   @id @default(cuid())
  memberId      String
  siteId        String
  roleOverride  String
  grantedBy     String
  grantedByName String?
  createdAt     DateTime @default(now())

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  site   Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([memberId, siteId])
  @@map("site_permissions")
}

model Subscription {
  id                       String   @id @default(cuid())
  workspaceId              String   @unique
  stripeSubscriptionId     String   @unique
  stripeCurrentPeriodStart DateTime
  stripeCurrentPeriodEnd   DateTime
  stripePriceId            String
  plan                     String   @default("FREE")
  status                   String   @default("ACTIVE")
  interval                 String   @default("MONTHLY")
  price                    Int
  currency                 String   @default("usd")
  cancelAtPeriodEnd        Boolean  @default(false)
  cancelReason             String?
  cancelFeedback           String?
  isGrandfathered          Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod?

  @@map("subscriptions")
}

model PaymentMethod {
  id                    String @id @default(cuid())
  subscriptionId        String @unique
  stripePaymentMethodId String
  type                  String
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Invoice {
  id              String    @id @default(cuid())
  workspaceId     String
  stripeInvoiceId String    @unique
  amount          Int
  currency        String    @default("usd")
  status          String    @default("PENDING")
  pdfUrl          String?
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
  @@map("invoices")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  actorId   String?
  actorName String?
  message   String
  actionUrl String?
  read      Boolean  @default(false)
  emailSent Boolean  @default(false)
  priority  String   @default("medium")
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model AIUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayBucket String
  count     Int      @default(0)
  model     String
  updatedAt DateTime @updatedAt

  @@unique([userId, dayBucket])
  @@index([userId])
  @@map("ai_usage")
}

// AI adoption telemetry (task-level): which AI edits get applied, reverted, and
// agent-run outcomes. Kept SEPARATE from ActivityLog so high-volume AI events
// never pollute the user-facing activity feeds. Privacy: metadata holds
// STRUCTURAL metrics only (command names, scope, counts, durations) — never
// prompt text, token values, or page content.
model AiAdoptionEvent {
  id          String   @id @default(cuid())
  workspaceId String
  siteId      String?
  actorId     String?
  event       String // "edit.applied" | "edit.reverted" | "agent.run"
  surface     String? // "inline" | "chat" | "agent"
  model       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, event, createdAt])
  @@index([siteId, createdAt])
  @@map("ai_adoption_events")
}

// Single-use confirmation grant for a privileged AI action (platform phase 5).
// propose creates a row; confirm consumes it atomically (usedAt) so a grant can
// be executed exactly once and only before it expires — replaces the replayable
// stateless HMAC token. The row id IS the token (random cuid, unguessable);
// confirm also checks actorId matches the session.
model ActionConfirmation {
  id        String    @id @default(cuid())
  actorId   String
  siteId    String
  actionId  String
  argsHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([actorId])
  @@index([expiresAt])
  @@map("action_confirmations")
}

